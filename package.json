{
  "name": "anyfilter",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && wxt build",
    "zip": "pnpm typecheck && wxt zip",
    "postinstall": "wxt prepare",
    "test:unit": "node scripts/unit-tests.mjs",
    "eval:rules": "node scripts/eval-rules.mjs",
    "review:blind": "node scripts/blind-review.mjs",
    "eval:import": "node scripts/import-evaluation-export.mjs",
    "eval:report": "node scripts/evaluation-report.mjs",
    "review:report": "node scripts/review-labels-report.mjs",
    "rule:replay": "node scripts/rule-replay.mjs",
    "rule:apply": "node scripts/apply-rule-pack.mjs",
    "e2e": "node scripts/e2e-offline.mjs",
    "e2e:page": "node scripts/e2e-page-judge.mjs",
    "e2e:auto": "node scripts/e2e-auto-mode.mjs",
    "e2e:hn": "node scripts/e2e-hn.mjs",
    "docs:screenshots": "node scripts/readme-screenshots.mjs"
  },
  "dependencies": {
    "defuddle": "0.19.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/chrome": "^0.0.320",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.3",
    "@wxt-dev/module-react": "^1.1.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "wxt": "^0.20.6"
  }
}
